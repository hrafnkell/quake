# systemd notendaþjónusta, sett upp í ~/.config/systemd/user/ af deploy/deploy.sh
[Unit]
Description=Quake (jarðskjálftakort)
After=network-online.target

[Service]
WorkingDirectory=%h/srv/quake
Environment=HOST=127.0.0.1
Environment=PORT=3060
Environment=DB_PATH=%h/srv/quake/data/quakes.db
Environment=POLL_SECONDS=300
# Valfrjálst: yfirskrifa stillingar án þess að breyta þessari skrá
EnvironmentFile=-%h/srv/quake/.env
ExecStart=%h/.bun/bin/bun run src/server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
